<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%if(session.getAttribute("userEmail")!=null){response.sendRedirect(request.getContextPath()+"/vote.jsp");return;}%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Register | ShopVote</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/style.css"></head><body><main class="auth-shell"><section class="auth-card"><a class="brand" href="login.jsp">Shop<span>Vote</span></a><p class="eyebrow">JOIN THE COMMUNITY</p><h1>Create your account</h1><p class="muted">A few details, then you're ready to vote.</p><%if("invalid".equals(request.getParameter("error"))){%><div class="alert">Use a valid email, a password of at least 8 characters, and matching passwords.</div><%}%><%if("exists".equals(request.getParameter("error"))){%><div class="alert">That email already has an account. Please log in.</div><%}%><form action="<%=request.getContextPath()%>/register" method="post" class="form"><label for="name">Full name</label><input id="name" name="name" required maxlength="80" placeholder="Your name"><label for="email">Email address</label><input id="email" name="email" type="email" required maxlength="160" placeholder="you@example.com"><label for="password">Password <span class="label-note">8+ characters</span></label><input id="password" name="password" type="password" minlength="8" required placeholder="Create a password"><label for="confirmPassword">Confirm password</label><input id="confirmPassword" name="confirmPassword" type="password" minlength="8" required placeholder="Repeat your password"><button class="button" type="submit">Create account <span>→</span></button></form><p class="switch-text">Already registered? <a href="<%=request.getContextPath()%>/login.jsp">Log in</a></p></section><aside class="auth-aside"><div class="orb">✦</div><p class="eyebrow">WELCOME TO SHOPVOTE</p><h2>Your opinion belongs here.</h2><p>Vote once across four fun categories and see how your choices compare with everyone else's.</p><div class="mini-pills"><span>Quick</span><span>Simple</span><span>Community-led</span></div></aside></main></body></html>
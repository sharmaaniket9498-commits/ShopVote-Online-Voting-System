<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="com.shopvote.ShopVoteStore,java.util.List" %><%String email=(String)session.getAttribute("userEmail");ShopVoteStore st=ShopVoteStore.get();boolean done=st.voted(email);%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Vote | ShopVote</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/style.css"></head><body class="app-page"><header class="topbar"><a class="brand" href="vote.jsp">Shop<span>Vote</span></a><nav><a class="nav-link active" href="vote.jsp">Vote</a><a class="nav-link" href="results.jsp">Results</a><a class="nav-link logout" href="logout">Log out</a></nav></header><main class="content"><div class="page-intro"><p class="eyebrow">THE COMMUNITY POLL</p><h1>What are your favourites?</h1><p class="muted">Choose one option for each question. You can submit your answers only once.</p></div><%if("incomplete".equals(request.getParameter("error"))){%><div class="alert">Please select an option for all four questions.</div><%}%><%if(done){%><section class="done-panel"><div class="done-icon">✓</div><h2>Your vote is already in!</h2><p class="muted">Each account can submit one complete ballot.</p><a class="button button-inline" href="results.jsp">View results →</a></section><%}else{%><form action="<%=request.getContextPath()%>/vote" method="post" class="vote-form"><%for(int q=1;q<=4;q++){List<String> opts=ShopVoteStore.options(q);%><section class="question-card"><div class="question-top"><span class="question-number">0<%=q%></span><span class="question-progress">QUESTION <%=q%> OF 4</span></div><h2><%=ShopVoteStore.question(q)%></h2><div class="options-grid"><%for(String opt:opts){%><label class="option"><input type="radio" name="q<%=q%>" value="<%=opt%>" required><span class="custom-radio"></span><span><%=opt%></span></label><%}%></div></section><%}%><div class="submit-row"><p class="muted small">Your choices are saved together when you submit.</p><button class="button" type="submit">Submit all answers <span>→</span></button></div></form><%}%></main><footer class="footer">Made for curious minds. <span>ShopVote</span></footer></body></html>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="com.shopvote.ShopVoteStore,java.util.Map" %><%ShopVoteStore st=ShopVoteStore.get();%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Results | ShopVote</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/style.css"></head><body class="app-page"><header class="topbar"><a class="brand" href="vote.jsp">Shop<span>Vote</span></a><nav><a class="nav-link" href="vote.jsp">Vote</a><a class="nav-link active" href="results.jsp">Results</a><a class="nav-link logout" href="logout">Log out</a></nav></header><main class="content"><div class="page-intro"><p class="eyebrow">THE RESULTS ARE IN</p><h1>Here's what everyone chose.</h1><p class="muted">Live totals from submitted ballots. No charts, just clear counts and percentages.</p></div><%if("success".equals(request.getParameter("status"))){%><div class="success">Your answers have been submitted. Thanks for voting!</div><%}%><%if("already".equals(request.getParameter("status"))){%><div class="success">Your account has already submitted its vote.</div><%}%><section class="stats-row"><div class="stat-card"><span class="stat-label">REGISTERED USERS</span><strong><%=st.voters()%></strong><span class="stat-caption">Community members</span></div><div class="stat-card"><span class="stat-label">BALLOTS SUBMITTED</span><strong><%=st.total(1)%></strong><span class="stat-caption">Complete submissions</span></div></section><div class="results-list"><%for(int q=1;q<=4;q++){Map<String,Integer> counts=st.counts(q);int total=st.total(q),max=0;for(int n:counts.values())if(n>max)max=n;%><section class="result-card"><div class="result-heading"><span class="question-number">0<%=q%></span><div><p class="eyebrow">CATEGORY <%=q%></p><h2><%=ShopVoteStore.question(q)%></h2></div><span class="total-pill"><%=total%> votes</span></div><div class="result-options"><%for(Map.Entry<String,Integer> en:counts.entrySet()){int n=en.getValue(),pct=total==0?0:(int)Math.round(n*100.0/total);%><div class="result-option"><div class="result-label"><span><%=en.getKey()%><%if(total>0&&n==max){%><span class="winner-tag">TOP PICK</span><%}%></span><strong><%=n%> <span class="muted">· <%=pct%>%</span></strong></div><div class="bar-track"><div class="bar-fill" style="width:<%=pct%>%"></div></div></div><%}%></div><%if(total==0){%><p class="muted small no-votes">No votes yet for this question.</p><%}%></section><%}%></div><div class="center-action"><a class="button button-inline" href="vote.jsp">Back to voting →</a></div></main><footer class="footer">Thanks for being part of the poll. <span>ShopVote</span></footer></body></html>